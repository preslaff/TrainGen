# TrainGen configuration — copy to .env and fill in. The real .env is gitignored.
# Precedence: real shell env > .env file > manifest defaults: block > built-in default.
# Structured config (viewport*, voices, login selectors, scenarios) lives in
# manifest/scenarios.yaml; everything tunable/secret lives here.

# ── Secrets ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # required for synthesize + Anthropic script narration
TRAINGEN_ADMIN_PASSWORD=           # admin login secret for record/verify (e.g. the admin key)
# TRAINGEN_MEMBER_PASSWORD=        # if/when member login is automatable

# ── Platform target (record/verify) ────────────────────────────────────────────
TRAINGEN_BASE_URL=http://localhost:3000   # staging demo tenant — NEVER production
TRAINGEN_HEADLESS=1                # 1 = headless (recommended). Headed Chromium can hang some
                                   # GPUs (confirmed amdgpu display freeze on this box).
# Chromium launch flags (comma-separated). On AMD/older GPUs, disable the GPU to avoid
# amdgpu VM faults / flip_done display hangs while recording:
TRAINGEN_BROWSER_ARGS=--disable-gpu,--disable-dev-shm-usage

# ── Production pipeline (record/compose/timing) ────────────────────────────────
TRAINGEN_VIEWPORT=1920x1080
TRAINGEN_FPS=30
TRAINGEN_LANGS=bg,en
# Pacing (raise these if the video feels too fast for viewers):
TRAINGEN_PACE=1.0                  # global dwell multiplier — 1.5 = 50% slower everywhere
TRAINGEN_TYPE_DELAY_MS=60          # per-character typing delay (visible typing; 0 = instant)
TRAINGEN_CURSOR_TRAVEL_S=0.8       # how long the cursor glides to each target
TRAINGEN_TAIL_PAD_S=0.4            # breathing room added after every step
TRAINGEN_REC_START_PAD_S=0.5       # lead-in before the first step

# ── TTS (narrate) ──────────────────────────────────────────────────────────────
TRAINGEN_TTS=offline               # offline (espeak-ng / silent) | omnivoice (pip install omnivoice torch)

# ── Subtitles (subtitle) ───────────────────────────────────────────────────────
TRAINGEN_SUBTITLES=per_step        # per_step (no dep) | aeneas (pip install aeneas)

# ── Script narration LLM (script) ──────────────────────────────────────────────
TRAINGEN_SCRIPT_BACKEND=anthropic  # anthropic | echo (no key -> auto echo)
TRAINGEN_SCRIPT_MODEL=claude-opus-4-8
TRAINGEN_SCRIPT_EFFORT=low

# ── Discovery: Layer 1 extract ─────────────────────────────────────────────────
TRAINGEN_OPENAPI_URL=http://localhost:8000/openapi.json
TRAINGEN_FRONTEND_APP=../Tourism_API/frontend/src/app   # path to the Next.js app/ tree

# ── Discovery: Layer 2 synthesize ──────────────────────────────────────────────
TRAINGEN_SYNTH_MODEL=claude-opus-4-8
TRAINGEN_SYNTH_EFFORT=medium

# ── Discovery: Layer 3 verify ──────────────────────────────────────────────────
TRAINGEN_VERIFY_MAX_STEPS=12
TRAINGEN_VERIFY_EXPAND=1            # 0 to disable live control discovery
TRAINGEN_VERIFY_MATCHER=heuristic  # heuristic | llm | vision (vision = screenshot-grounded binding)
TRAINGEN_VISION_MODEL=claude-opus-4-8   # multimodal model for the vision matcher
TRAINGEN_LIVE_LOCALE=en            # locale re-inserted into stripped routes for live URLs
